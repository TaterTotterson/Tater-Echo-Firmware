# 0052-cdcether-rtl8152-no-blacklist.patch — Tater USB-Ethernet work (2026-10-25)
#
# Not a CVE backport: a targeted fix of an upstream 3.18.19 table entry.
# Root cause found on hardware 2026-10-25: cdc_ether's USB_DEVICE_AND_INTERFACE_
# INFO(0bda, 0x8152, CDC ECM) entry carries .driver_info = 0 — an intentional
# blacklist reject (upstream expects the r8152 vendor driver to claim the
# device). usbnet_probe turns driver_info=0 into a silent -ENODEV, so the
# UCTRONICS U6113 adapter (Realtek RTL8152, 0bda:8152 bcdDevice 0x0200) never
# created eth0 and printed nothing. This build ships r8152 only as an optional
# module, so the entry is removed and the generic CDC-ECM whitelist entry
# claims the device via cdc_info. cdc_ether.c is grafted from upstream
# linux-3.18.19 by build-kernel.sh.
--- a/drivers/net/usb/cdc_ether.c
+++ b/drivers/net/usb/cdc_ether.c
@@ -680,12 +680,11 @@
 	.driver_info = 0,
 },
 
-/* Realtek RTL8152 Based USB 2.0 Ethernet Adapters */
-{
-	USB_DEVICE_AND_INTERFACE_INFO(REALTEK_VENDOR_ID, 0x8152, USB_CLASS_COMM,
-			USB_CDC_SUBCLASS_ETHERNET, USB_CDC_PROTO_NONE),
-	.driver_info = 0,
-},
+/* Tater 3.18 port: the 0bda:8152 CDC-ECM entry (driver_info = 0) was removed.
+ * Upstream lists it so cdc_ether silently rejects RTL8152 devices in favor of
+ * the bundled r8152 vendor driver; this build never auto-binds r8152 at boot,
+ * so the reject left the adapter unclaimed. The generic whitelist entry below
+ * now matches it and cdc_info drives the interface. */
 
 /* Realtek RTL8153 Based USB 3.0 Ethernet Adapters */
 {
