# 0050-r8152-3.18-eee-helpers.patch — Tater USB-Ethernet work (2026-10-25)
#
# Not a CVE backport: a Tater port. Built-in-only kernels need CONFIG_USB_RTL8152 (Biscuit's
# Realtek RTL8152 micro-USB Ethernet adapter, plan-B vendor-mode binding) but this 3.18 build
# never compiled r8152. The driver's EEE code calls mmd_eee_cap_to_ethtool_sup_t(),
# mmd_eee_adv_to_ethtool_adv_t() and ethtool_adv_to_mmd_eee_adv_t(), which 3.18 lacks; this
# adds byte copies of the upstream helpers (guarded <4.2) plus the linux/version.h include.
# drivers/net/usb/r8152.c is grafted from upstream linux-3.18.19 by build-kernel.sh, so this
# applies on top of the graft. No upstream fix to backport; Tater-local.
--- a/drivers/net/usb/r8152.c	2026-10-25 11:21:04.993726963 -0700
+++ b/drivers/net/usb/r8152.c	2026-10-25 11:21:06.393728233 -0700
@@ -24,6 +24,48 @@
 #include <net/ip6_checksum.h>
 #include <uapi/linux/mdio.h>
 #include <linux/mdio.h>
+#include <linux/version.h> /* Tater 3.18 port: the EEE helpers below key off LINUX_VERSION_CODE */
+
+/* Tater 3.18 port: the mmd_eee_*_to_ethtool_*() and ethtool_adv_to_mmd_eee_*()
+ * EEE converters do not exist in 3.18; byte copies of the upstream helpers.
+ * TODO(verify): first upstream version (believed 4.2); only 3.18 is built here. */
+#if KERNEL_VERSION(4, 2, 0) > LINUX_VERSION_CODE
+static inline u32 mmd_eee_cap_to_ethtool_sup_t(u16 eee_cap)
+{
+	u32 cap = 0;
+
+	if (eee_cap & MDIO_EEE_100TX)
+		cap |= SUPPORTED_100baseT_Full;
+	if (eee_cap & MDIO_EEE_1000T)
+		cap |= SUPPORTED_1000baseT_Full;
+
+	return cap;
+}
+
+static inline u32 mmd_eee_adv_to_ethtool_adv_t(u16 eee_adv)
+{
+	u32 adv = 0;
+
+	if (eee_adv & MDIO_EEE_100TX)
+		adv |= ADVERTISED_100baseT_Full;
+	if (eee_adv & MDIO_EEE_1000T)
+		adv |= ADVERTISED_1000baseT_Full;
+
+	return adv;
+}
+
+static inline u16 ethtool_adv_to_mmd_eee_adv_t(u32 eth_adv)
+{
+	u16 mmd_adv = 0;
+
+	if (eth_adv & SUPPORTED_100baseT_Full)
+		mmd_adv |= MDIO_EEE_100TX;
+	if (eth_adv & SUPPORTED_1000baseT_Full)
+		mmd_adv |= MDIO_EEE_1000T;
+
+	return mmd_adv;
+}
+#endif
 
