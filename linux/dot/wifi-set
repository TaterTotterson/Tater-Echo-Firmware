#!/bin/sh
# Maintenance-console Wi-Fi setter for Biscuit/Radar Tater Linux.
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
CONF=/data/tater-linux/wpa_supplicant.conf

die() { echo "wifi-set: $*" >&2; exit 1; }
[ -d /data/tater-linux ] || die "userdata is not mounted"

case "${1:-}" in
--forget)
	rm -f "$CONF"
	tater-net stop 2>/dev/null || true
	sync
	echo "wifi-set: Tater network forgotten"
	exit 0
	;;
--hex)
	echo "${2:-}" | grep -Eq '^([0-9a-fA-F]{2}){1,32}$' || die "the name must be 1-32 bytes of hex"
	echo "${3:-}" | grep -Eq '^[0-9a-fA-F]{64}$' || die "the key must be 64 hex digits"
	ssid=$2
	psk=$3
	;;
"" | -h | --help)
	echo 'usage: wifi-set "Network name" "passphrase" | --hex <ssid-hex> <psk-hex> | --forget' >&2
	exit 1
	;;
*)
	[ "${#1}" -le 32 ] || die "a network name is at most 32 bytes"
	password=${2:-}
	[ "${#password}" -ge 8 ] && [ "${#password}" -le 63 ] || die "a WPA passphrase is 8 to 63 characters"
	ssid=$(printf %s "$1" | od -An -v -tx1 | tr -d ' \n')
	psk=$(wpa_passphrase "$1" "$password" | sed -n 's/^[ \t]*psk=\([0-9a-f]\{64\}\)$/\1/p')
	[ -n "$psk" ] || die "wpa_passphrase gave no key"
	;;
esac

( umask 077
  printf 'ctrl_interface=/run/wpa\nupdate_config=0\nnetwork={\n\tssid=%s\n\tpsk=%s\n\tkey_mgmt=WPA-PSK\n}\n' \
      "$ssid" "$psk" > "$CONF.tmp"
  mv -f "$CONF.tmp" "$CONF" )
sync
echo "wifi-set: saved"
exec tater-net restart
